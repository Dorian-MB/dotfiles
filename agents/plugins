# Install ponytail
/plugin marketplace add DietrichGebert/ponytail
/plugin install ponytail@ponytail

# Install graphifyy
uv tool install graphifyy      # install the CLI (or: pipx install graphifyy)
graphify install

# Install Agents Skills
# git config --global url."https://github.com/".insteadOf git@github.com:
/plugin marketplace add https://github.com/addyosmani/agent-skills.git
/plugin install agent-skills@addy-agent-skills

# mods
## Skins mods, change theme
/plugin marketplace add hellosverre/claude-skins
/plugin install skins@hellosverre-mods
# then (linux + mac): catppuccin tables without opaque bands.
# Re-run after each plugin update (it overwrites the cache), then restart claude + `/skin catppuccin`.
for d in ~/.claude/plugins/cache/hellosverre-mods/skins/*/; do (cd "$d" && git apply ~/dotfiles/agents/skins/transparent.patch); done

# File tree explorer (what claude edit) 
/plugin marketplace add data-goblin/claude-code-filetree
/plugin install filetree@claude-code-filetree
# keys (alt+o tree, alt+i back, alt+x close; alt+h/l taken by AeroSpace). Don't run /filetree keys, it rewrites them.
ln -sf ~/dotfiles/agents/keybindings.json ~/.claude/keybindings.json

## pane-glass (own mod, agents/pane-glass): every plugin pane (/skin, /filetree, /replay...) opens transparent
claude plugin marketplace add ~/dotfiles/agents
claude plugin install pane-glass@dotfiles

## claude-kit mods: progress bar + agents panel, session band (cost, cache, context)
/plugin marketplace add johnnyvizz/claude-kit
/plugin install savvy-progress@claude-kit
/plugin install session-band@claude-kit

# savvy-flow (skill + agents), modified copy in agents/savvy-flow/:
# the orchestrator picks the model per worker task (haiku/sonnet/opus/fable),
# light defaults to haiku, medium to sonnet. Do NOT also install savvy-flow@claude-kit.
mkdir -p ~/.claude/skills ~/.claude/agents
cp -R ~/dotfiles/agents/savvy-flow/skills/savvy-flow ~/.claude/skills/
cp ~/dotfiles/agents/savvy-flow/agents/*.md ~/.claude/agents/


# keep warm 
claude plugin marketplace add karanb192/claude-code-mods
claude plugin install cache-tax@claude-code-mods


# Anthropic's sample (marketplace lives in a subfolder, so clone then add the path)
git clone --depth 1 https://github.com/anthropics/claude-code-playground ~/.claude/claude-code-playground
claude plugin marketplace add ~/.claude/claude-code-playground/claude-code/mods
claude plugin install replay-theater@claude-code-playground-mods --scope user
# blast-radius uninstalled: it holds risky commands in a pane with no notification, easy to miss.
