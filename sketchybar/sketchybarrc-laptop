#!/usr/bin/env zsh

FONT_FACE="JetBrainsMono Nerd Font"

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins-laptop"
PLUGIN_SHARED_DIR="$HOME/.config/sketchybar/plugins"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/helpers/workspaces.sh"

SPOTIFY_EVENT="com.spotify.client.PlaybackStateChanged"

sketchybar --bar \
    height=33 \
    color=0x30000000 \
    margin=0 \
    sticky=on \
    padding_left=23 \
    padding_right=23 \
    notch_width=188 \
    blur_radius=4 \
    display=main

# Alternatiive background colors
# label.color=0xffffffff // label.color=0xffcad3f5
# background.color=0x9924273a // background.color=0x66494d64
sketchybar --default \
    background.color=0x9924273a \
    background.corner_radius=5 \
    background.padding_right=5 \
    background.height=26 \
    icon.font="$FONT_FACE:Medium:21.0" \
    icon.padding_left=5 \
    icon.padding_right=5 \
    label.font="$FONT_FACE:Medium:16.0" \
    label.color=0xffffffff \
    label.y_offset=0 \
    label.padding_left=0 \
    label.padding_right=5

sketchybar --add event spotify_change $SPOTIFY_EVENT \
    --add item spotify e \
    --set spotify \
    icon= \
    icon.y_offset=1 \
    icon.font="$FONT_FACE:Bold:20.0" \
    label.drawing=off \
    label.padding_left=3 \
    script="$PLUGIN_DIR/spotify.sh" \
    --subscribe spotify spotify_change mouse.clicked

# Catppuccin logo, far left, before the workspaces. Click to fully
# reload sketchybar.
sketchybar --add item logo left \
    --set logo \
    icon=󰅶 \
    icon.color=$CAT_BASE \
    background.color=$CAT_PEACH \
    padding_right=6 \
    label.drawing=off \
    script="$PLUGIN_SHARED_DIR/reload.sh" \
    --subscribe logo mouse.clicked

# AeroSpace workspaces: one item per workspace, hidden until it has a window
# open (or is the focused one). See helpers/workspaces.sh for the list and
# plugins/aerospace_workspaces.sh for the show/hide + icon logic.
sketchybar --add event aerospace_workspace_change

for ws in "${AEROSPACE_WORKSPACES[@]}"; do
    sketchybar --add space aerospace.workspace.$ws left \
        --set aerospace.workspace.$ws \
        associated_display=1 \
        icon.font="sketchybar-app-font:Regular:16.0" \
        icon.padding_left=8 \
        icon.padding_right=4 \
        label.font="$FONT_FACE:Bold:14.0" \
        label.padding_left=4 \
        label.padding_right=8 \
        background.border_width=0 \
        background.drawing=on \
        click_script="aerospace workspace $ws &" \
        drawing=off
done

sketchybar --add item front_app left \
    --set front_app \
    background.color=0xffa6da95 \
    background.padding_left=0 \
    background.padding_right=0 \
    icon.y_offset=1 \
    icon.color=0xff24273a \
    label.drawing=no \
    script="$PLUGIN_SHARED_DIR/front_app.sh" \
    --add item front_app.separator left \
    --set front_app.separator \
    background.color=0x00000000 \
    background.padding_left=-3 \
    icon= \
    icon.color=0xffa6da95 \
    icon.font="$FONT_FACE:Bold:20.0" \
    icon.padding_left=0 \
    icon.padding_right=0 \
    icon.y_offset=1 \
    label.drawing=no \
    --add item front_app.name left \
    --set front_app.name \
    background.color=0x00000000 \
    background.padding_right=0 \
    icon.drawing=off \
    label.font="$FONT_FACE:Bold:15.0" \
    label.drawing=yes

sketchybar --add bracket front_app_bracket \
    front_app \
    front_app.separator \
    front_app.name \
    --subscribe front_app front_app_switched

sketchybar --add item clock right \
    --set clock \
    icon=󰃰 \
    icon.color=0xffed8796 \
    update_freq=10 \
    script="$PLUGIN_SHARED_DIR/clock.sh"

sketchybar --add item battery right \
    --set battery \
    update_freq=20 \
    script="$PLUGIN_DIR/battery.sh"

sketchybar --add item volume right \
    --set volume \
    icon.color=0xff8aadf4 \
    label.drawing=true \
    script="$PLUGIN_SHARED_DIR/volume.sh" \
    --subscribe volume volume_change

# Drives the workspace items on workspace switches and whenever the front
# app changes (covers windows opening/closing/moving between workspaces).
sketchybar --add item aerospace_listener left \
    --set aerospace_listener \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    width=0 \
    script="$PLUGIN_SHARED_DIR/aerospace_workspaces.sh" \
    --subscribe aerospace_listener aerospace_workspace_change front_app_switched

# osascript -e 'quit app "Rectangle"'
# open -a Rectangle

##### Finalizing Setup #####
bash "$PLUGIN_SHARED_DIR/aerospace_workspaces.sh"
sketchybar --update
