# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
# Empty values reset the configuration to the default value

macos-titlebar-style = hidden
window-show-tab-bar = never
window-decoration = true

window-save-state = always
maximize = true
confirm-close-surface = false
quick-terminal-position = center
window-padding-x = 10,10
window-padding-y = 10,10
window-padding-balance = true

font-family = JetBrainsMono Nerd Font
font-size=19
font-thicken = true
font-thicken-strength = 0

# background = 1E1E2E
# foreground = ffffff

# theme = Catppuccin Latte
theme = Catppuccin Macchiato

# background: (opacity of image is back_opacity * img_opacity)
background-image-fit = cover
# background-image = "/Users/dorian/Documents/Prepa/cours info psi/SB/a.png"
# background-image = "/Users/dorian/Documents/Prepa/cours info psi/SB/wings.png"
background-image-opacity = 0.1
background-opacity = 0.85
background-blur = 13

macos-option-as-alt = left

# Split navigation. NOT bound to ctrl+tab: ghostty would swallow it and
# nvim's <C-Tab> ("switch to previous file", see nvim/lua/mappings.lua)
# would never fire inside a ghostty window.
# ghostty binds ctrl+tab=next_tab by default (even with the tab bar hidden),
# and once unbound it sends a plain Tab unless the app enabled the kitty
# keyboard protocol. Send the CSI u sequence explicitly so nvim always sees
# <C-Tab> / <C-S-Tab>.
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u
keybind = cmd+]=goto_split:next
keybind = cmd+[=goto_split:previous



